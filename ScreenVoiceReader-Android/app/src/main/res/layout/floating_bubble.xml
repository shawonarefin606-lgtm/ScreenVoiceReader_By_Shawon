<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <ImageButton
        android:id="@+id/btnReadScreen"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bubble_bg"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#FFFFFF"
        android:contentDescription="Read Screen Text"
        android:elevation="6dp" />

    <ImageButton
        android:id="@+id/btnStopSpeech"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/stop_bg"
        android:src="@android:drawable/ic_media_pause"
        android:tint="#FFFFFF"
        android:visibility="gone"
        android:contentDescription="Stop Reading"
        android:elevation="6dp" />

</LinearLayout>
